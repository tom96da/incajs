// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/rust
{
  "name": "Incarnative.js",
  // Extends the base rust devcontainer image with gpui's native build deps
  // (see .devcontainer/Dockerfile). More info: https://containers.dev/guide/dockerfile
  "build": {
    "dockerfile": "Dockerfile"
  },

  "remoteEnv": {
    "WORKSPACE_FOLDER": "${containerWorkspaceFolder}"
  },
  // Use 'mounts' to make the cargo cache, target/, node_modules, and
  // ~/.claude persistent in Docker Volumes.
  "mounts": [
    "source=devcontainer-cargo-cache-${devcontainerId},target=/usr/local/cargo,type=volume",
    "source=devcontainer-cargo-target-${devcontainerId},target=${containerWorkspaceFolder}/target,type=volume",
    "source=devcontainer-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume",
    "source=devcontainer-claude-home-${devcontainerId},target=/home/vscode/.claude,type=volume",
    "source=${localEnv:HOME}/.claude/.credentials-devcontainer.json,target=/home/vscode/.claude/.credentials.json,type=bind",
    "source=${localEnv:HOME}/.claude.devcontainer.json,target=/home/vscode/.claude.json,type=bind"
  ],

  // Features to add to the dev container. More info: https://containers.dev/features.
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26",
      "pnpmVersion": "12"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
  },

  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  // "forwardPorts": [],

  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": ". .devcontainer/post-create.sh",

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "settings": {
        "rust-analyzer.files.watcher": "server",
        "rust-analyzer.check.workspace": false
      },
      "extensions": [
        // Common extensions.
        "editorconfig.editorconfig",
        "timonwong.shellcheck",

        // Git extensions.
        "mhutchie.git-graph",
        "eamodio.gitlens",

        // Frontend extensions.
        "vue.volar",
        "vitest.explorer",
        "oxc.oxc-vscode"
      ]
    }
  }

  // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
  // "remoteUser": "root"
}
