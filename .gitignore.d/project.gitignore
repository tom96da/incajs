# project.gitignore

# Logs
logs/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
tmp/
temp/
*.tmp

# Prebuilt host binaries a CD workflow drops into npm/<os>-<arch>/ before publish
/npm/*/bin/

# License files a CD workflow copies into the packages before publish
/packages/*/LICENSE-MIT
/packages/*/LICENSE-APACHE
/npm/*/LICENSE-MIT
/npm/*/LICENSE-APACHE
/npm/*/NOTICE
