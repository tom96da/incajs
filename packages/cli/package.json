{
  "name": "@incajs/cli",
  "version": "0.0.1",
  "description": "The inca CLI: watches an app's entry point through a bundler adapter, starts inca-host once the first bundle lands, and reloads it on every rebuild.",
  "keywords": [
    "bundler",
    "cli",
    "desktop-app",
    "dev-server",
    "gpui",
    "gui",
    "incajs",
    "incarnative.js",
    "json-rpc",
    "quickjs",
    "vite"
  ],
  "homepage": "https://tom96da.github.io/incajs/",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/incajs.git",
    "directory": "packages/cli"
  },
  "bin": {
    "inca": "./bin/inca.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    },
    "./config": {
      "source": "./src/config/index.mts",
      "types": "./dist/config/index.d.mts",
      "import": "./dist/config.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config/index.d.mts",
        "import": "./dist/config.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --check .",
    "typecheck": "oxlint -A all --type-aware --type-check"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "vite": "^8.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vue/runtime-core": "^3.5.42",
    "c12": "4.0.0-rc.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "rolldown": "~1.2.4",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vue": "^3.5.42"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@incajs/host-darwin-arm64": "workspace:*",
    "@incajs/host-linux-arm64": "workspace:*",
    "@incajs/host-linux-x64": "workspace:*"
  },
  "engines": {
    "node": ">=22.18"
  }
}
