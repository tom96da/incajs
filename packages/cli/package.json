{
  "name": "@incajs/cli",
  "version": "0.0.25",
  "description": "Commands to develop, bundle, and package Incarnative.js apps.",
  "keywords": [
    "bundler",
    "cli",
    "desktop-app",
    "dev-server",
    "gpui",
    "gui",
    "incajs",
    "incarnative.js",
    "json-rpc",
    "quickjs",
    "vite"
  ],
  "homepage": "https://incajs.tom96da.com/",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/incajs.git",
    "directory": "packages/cli"
  },
  "bin": {
    "inca": "./bin/inca.mjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "sideEffects": [
    "src/vite/runtime/globals.mts"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "source": "./src/config/index.mts",
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "import": "./dist/config.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --check .",
    "typecheck": "oxlint -A all --type-aware --type-check",
    "prepack": "clear-package-json package.json -o package.json"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.9",
    "vite": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vue/runtime-core": "catalog:",
    "c12": "4.0.0-rc.2",
    "citty": "0.2.2",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rolldown": "~1.2.15",
    "ts-dedent": "2.3.0",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@incajs/host-darwin-arm64": "workspace:*",
    "@incajs/host-darwin-x64": "workspace:*",
    "@incajs/host-linux-arm64": "workspace:*",
    "@incajs/host-linux-x64": "workspace:*"
  },
  "engines": {
    "node": ">=22.18"
  }
}
