{
  "name": "incajs",
  "version": "0.0.4",
  "description": "A GPU-native, Webview-free desktop app framework built on GPUI and QuickJS.",
  "keywords": [
    "cross-platform",
    "custom-renderer",
    "desktop-app",
    "electron-alternative",
    "framework-agnostic",
    "gpui",
    "gui",
    "incajs",
    "incarnative.js",
    "quickjs",
    "rust",
    "tauri-alternative",
    "vue",
    "vue3",
    "webview-free"
  ],
  "homepage": "https://tom96da.github.io/incajs/",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/incajs.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.mts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "source": "./src/vue/index.mts",
      "types": "./dist/vue/index.d.mts",
      "import": "./dist/vue.js"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.js"
      },
      "./vue": {
        "types": "./dist/vue/index.d.mts",
        "import": "./dist/vue.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --check .",
    "typecheck": "oxlint -A all --type-aware --type-check"
  },
  "devDependencies": {
    "@vue/runtime-core": "^3.5.43",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0"
  },
  "peerDependencies": {
    "@vue/runtime-core": "^3.5.43"
  },
  "peerDependenciesMeta": {
    "@vue/runtime-core": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
