{
  "name": "incajs",
  "version": "0.0.31",
  "description": "A GPU-native, Webview-free desktop app framework built on GPUI and QuickJS.",
  "keywords": [
    "cross-platform",
    "custom-renderer",
    "desktop-app",
    "electron-alternative",
    "framework-agnostic",
    "gpui",
    "gui",
    "incajs",
    "incarnative.js",
    "quickjs",
    "rust",
    "tauri-alternative",
    "vue",
    "vue3",
    "webview-free"
  ],
  "homepage": "https://incajs.tom96da.com/",
  "license": "(MIT OR Apache-2.0)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tom96da/incajs.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "type": "module",
  "sideEffects": [
    "src/callbacks.mts",
    "src/targets.mts",
    "dist/chunks/hooks-*.js"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.mts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./vue": {
      "source": "./src/vue/index.mts",
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./vue/runtime": {
      "source": "./src/vue/runtime.mts",
      "types": "./dist/vue-runtime.d.ts",
      "import": "./dist/vue-runtime.js"
    },
    "./style": {
      "source": "./src/style.mts",
      "types": "./dist/style.d.ts",
      "import": "./dist/style.js"
    },
    "./globals": {
      "source": "./src/globals.d.mts",
      "types": "./dist/globals.d.mts"
    }
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./vue": {
        "types": "./dist/vue.d.ts",
        "import": "./dist/vue.js"
      },
      "./vue/runtime": {
        "types": "./dist/vue-runtime.d.ts",
        "import": "./dist/vue-runtime.js"
      },
      "./style": {
        "types": "./dist/style.d.ts",
        "import": "./dist/style.js"
      },
      "./globals": {
        "types": "./dist/globals.d.mts"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "lint": "oxlint --type-aware",
    "format": "oxfmt --check .",
    "typecheck": "tsc -b --noEmit",
    "test:quickjs": "vitest run -c vitest.quickjs.config.mts",
    "prepack": "clear-package-json package.json -o package.json"
  },
  "devDependencies": {
    "@vue/runtime-core": "catalog:",
    "@vue/runtime-dom": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "rolldown": "catalog:",
    "vitest-pool-quickjs": "^0.1.0"
  },
  "peerDependencies": {
    "@vue/runtime-core": "catalog:",
    "@vue/runtime-dom": "catalog:",
    "vue": "catalog:"
  },
  "peerDependenciesMeta": {
    "@vue/runtime-core": {
      "optional": true
    },
    "@vue/runtime-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "incajs": {
    "frontends": {
      "vue": {
        "peers": [
          "@vue/runtime-core",
          "@vue/runtime-dom",
          "vue"
        ]
      }
    }
  }
}
